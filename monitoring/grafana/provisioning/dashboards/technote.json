{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Questions over time",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "technotepg"
      },
      "description": "Usage volume per hour.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "technotepg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour', ts) AS time, count(*) AS questions\nFROM conversations\nGROUP BY 1 ORDER BY 1;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "title": "Feedback ratio",
      "type": "piechart",
      "datasource": {
        "type": "postgres",
        "uid": "technotepg"
      },
      "description": "Thumbs up against thumbs down across all logged answers.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "technotepg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  count(*) FILTER (WHERE value = 1)  AS thumbs_up,\n  count(*) FILTER (WHERE value = -1) AS thumbs_down\nFROM feedback;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "title": "p95 response time by retrieval mode",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "technotepg"
      },
      "description": "Tail latency per mode. hybrid_rerank pays for the cross-encoder.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "technotepg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT mode, percentile_cont(0.95) WITHIN GROUP (ORDER BY response_ms) AS p95_ms\nFROM conversations\nGROUP BY mode;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "orientation": "horizontal",
        "xTickLabelRotation": 0
      }
    },
    {
      "id": 4,
      "title": "Abstention rate over time",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "technotepg"
      },
      "description": "Share of answers that returned NOT_FOUND. A sudden move in either direction usually means retrieval broke or the prompt regressed.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "technotepg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', ts) AS time,\n       avg(CASE WHEN abstained THEN 1.0 ELSE 0.0 END) AS abstention_rate\nFROM conversations\nGROUP BY 1 ORDER BY 1;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "title": "Token spend per day",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "technotepg"
      },
      "description": "Prompt and completion tokens per day.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "technotepg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', ts) AS time,\n       sum(coalesce(prompt_tokens, 0))     AS prompt_tokens,\n       sum(coalesce(completion_tokens, 0)) AS completion_tokens\nFROM conversations\nGROUP BY 1 ORDER BY 1;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "title": "Most retrieved documents",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "technotepg"
      },
      "description": "One technote dominating results usually points at a chunking or scoring problem.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "technotepg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT src AS filename, count(*) AS times_retrieved\nFROM conversations, jsonb_array_elements_text(sources) AS src\nGROUP BY 1 ORDER BY 2 DESC LIMIT 15;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "technote",
    "rag"
  ],
