# LLM endpoint. Any OpenAI-compatible API works.
# OpenAI:  leave OPENAI_BASE_URL empty
# Groq:    OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Ollama:  OPENAI_BASE_URL=http://host.docker.internal:11434/v1  (key can be anything)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini

# Extra headers for providers that need them, as a JSON object. OpenCode Zen
# requires a stable per-conversation id, for example:
# LLM_EXTRA_HEADERS={"x-opencode-session":"<uuid>","x-opencode-client":"cli"}
LLM_EXTRA_HEADERS=

# Infra. Defaults match docker-compose service names.
QDRANT_URL=http://qdrant:6333
PG_HOST=postgres
PG_PORT=5432
PG_DB=technote
PG_USER=technote
PG_PASSWORD=technote

GRAFANA_ADMIN_PASSWORD=admin
